# ScrubiMail backend — environment template (web + default worker).
#
# This is the env for the MAIN APP (Railway): the gunicorn web process and the
# Celery worker that consumes `default,embeddings`. The SMTP-egress worker on
# Hetzner uses a DIFFERENT file — see .env.smtp-egress.example.
#
# Copy to .env and fill in. Values shown are the PRODUCTION-correct defaults;
# the local-dev alternative is in a comment beside each.

# ── Core Django ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-50-random-chars
# DEBUG defaults to True in settings.py — you MUST set it to False in prod.
DEBUG=False
# Comma-separated. Defaults to "*" if unset; set it explicitly in prod.
ALLOWED_HOSTS=api.scrubimail.com,scrubimail.com

# ── Database ──────────────────────────────────────────────────────────────────
# Use the PRIVATE/INTERNAL hostname. Railway's public proxy endpoint
# (*.proxy.rlwy.net) costs ~260ms per query and ~2s per new connection — that
# alone was ~2.5s of every validation request. The internal hostname is sub-ms.
#   Railway internal : postgresql://user:pass@postgres.railway.internal:5432/railway
#   Local dev        : postgresql://postgres:pass@localhost:5432/scrubimail
DATABASE_URL=postgresql://user:pass@postgres.railway.internal:5432/railway
# Persistent connections (seconds). Without this Django reconnects every request.
DB_CONN_MAX_AGE=600

# ── Redis (cache + Celery broker) ─────────────────────────────────────────────
# Internal hostname from inside Railway. NOTE: the Hetzner egress worker cannot
# reach *.railway.internal — it needs the PUBLIC endpoint of this SAME Redis.
# Different Redis on the two sides = the egress worker never sees the jobs and
# every validation comes back sub_status=smtp_unavailable.
#
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND and CACHE_REDIS_URL all default to
# REDIS_URL, so this single var is enough. Set them only to point at a different
# Redis / DB index — and write the URL out in full (no ${REDIS_URL} expansion).
REDIS_URL=redis://default:pass@redis.railway.internal:6379/0

# ── Process sizing ────────────────────────────────────────────────────────────
# Read by the Procfile. WEB_CONCURRENCY defaults to 1 — a single gunicorn worker
# serializes every request, so one slow request blocks the rest and the edge
# starts returning 502s. Use ~2x CPU cores.
WEB_CONCURRENCY=4
CELERY_CONCURRENCY=2

# ── Email validation engine ───────────────────────────────────────────────────
# MUST stay False here. The web/worker hosts have no outbound port 25 (Railway
# blocks it), so an inline probe can only ever time out. Real mailbox
# verification happens on the Hetzner egress worker via the smtp_validation
# queue; the API enqueues to it and waits within the budget below.
VALIDATION_SMTP_ENABLED=False
# Wall-clock the single-validation endpoint will wait for the egress worker's
# verdict before returning an honest `unknown`.
VALIDATION_REALTIME_BUDGET_SECONDS=8
# If a probe is never claimed (no worker on the queue), skip the wait for this
# many seconds so an egress outage degrades instantly instead of costing every
# request the full budget. 0 disables.
VALIDATION_EGRESS_UNRESPONSIVE_COOLDOWN=60
# Result cache TTLs (seconds): terminal verdicts / unknowns.
VALIDATION_RESULT_CACHE_TTL=604800
VALIDATION_RESULT_CACHE_TTL_UNKNOWN=86400
# Bulk job chunk size (rows per progress update).
VALIDATION_BULK_CHUNK_SIZE=100

# ── Email (transactional) ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=ScrubiMail<noreply@scrubimail.com>

# ── Billing (Paystack) ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
PAYSTACK_CHARGE_CURRENCY=GHS
# FX: live rate via CurrencyFreaks, with a buffer and a static fallback.
CURRENCYFREAKS_API_KEY=
PAYSTACK_FX_USD_TO_GHS=15.0
PAYSTACK_FX_BUFFER=1.05
PAYSTACK_FX_CACHE_TTL=3600
PAYSTACK_MIN_GHS_MAJOR=2.00

# ── Frontend / OAuth ──────────────────────────────────────────────────────────
# Payment success/cancel/failed URLs and the OAuth callback default off this.
FRONTEND_URL=https://app.scrubimail.com
# Where the OAuth provider redirects back to (must match the provider console).
OAUTH_REDIRECT_BASE_URI=https://api.scrubimail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
