# SMTP-egress worker — environment template (Hetzner box ONLY).
#
# This box runs ONE thing: a Celery worker consuming the `smtp_validation`
# queue. It is the only host with outbound port 25, so it is the only host that
# can confirm a mailbox. It runs NO web, NO migrations, NO collectstatic.
#
# WHERE THIS FILE LIVES ON THE BOX:
#   /srv/scrubimail/stack/staging/.env
# The deploy workflow (.github/workflows/deploy-smtp-egress.yml) copies that
# path to .env.smtp-egress next to docker-compose.smtp-egress.yml. The box owns
# these secrets — they are NOT injected from GitHub.
#
# ── THE RULE THAT MAKES OR BREAKS THIS WORKER ────────────────────────────────
# It must talk to the SAME Redis and the SAME Postgres as the main app, over
# PUBLIC endpoints. A Railway *.railway.internal hostname is unreachable from
# Hetzner: the worker then sits on a broker nobody publishes to, silently
# consuming nothing, and every single validation returns
# sub_status=smtp_unavailable. If jobs are not being picked up, check this
# first — `docker compose ... logs smtp-egress-worker` will show the transport
# it actually connected to.

# ── Django core (same secret/DB as the main app) ─────────────────────────────
DJANGO_SECRET_KEY=same-secret-as-the-main-app
DEBUG=False

# ── Shared Postgres — PUBLIC endpoint (proxy), not *.railway.internal ────────
# The worker writes EmailValidation rows for bulk jobs, so it needs the same DB
# the API reads. Wrong DB here = bulk tasks fail with "job not found".
DATABASE_URL=postgresql://user:pass@acela.proxy.rlwy.net:31220/railway
DB_CONN_MAX_AGE=600

# ── Shared Redis — PUBLIC endpoint. MUST be the broker the API publishes to ──
# CELERY_BROKER_URL, CELERY_RESULT_BACKEND and CACHE_REDIS_URL all fall back to
# REDIS_URL, so setting this one var is enough — and it guarantees the broker,
# the result backend and the shared cache can't drift onto different Redises.
# Do NOT write ${REDIS_URL} for the others: docker compose passes env_file
# values LITERALLY (no expansion), so Celery would try to dial a host called
# "${REDIS_URL}". Either omit them (recommended) or paste the full URL.
REDIS_URL=redis://default:pass@your-redis.proxy.rlwy.net:PORT/0

# ── SMTP mailbox verification — ON here, and ONLY here ───────────────────────
# (docker-compose.smtp-egress.yml also force-sets this to True.)
VALIDATION_SMTP_ENABLED=True
# The HELO host MUST have an A record AND a matching PTR (reverse DNS) for this
# box's IP — forward-confirmed reverse DNS. Set the PTR in the Hetzner console.
VALIDATION_SMTP_HELO_HOST=verify.scrubimail.com
# The MAIL FROM domain MUST publish SPF authorizing this box's IP,
# e.g. v=spf1 ip4:<this-box-ip> -all
VALIDATION_SMTP_MAIL_FROM=verify@scrubimail.com
VALIDATION_SMTP_TIMEOUT=5
VALIDATION_SMTP_STARTTLS=True
# Try up to N MX hosts, advancing only when a host fails to CONNECT.
VALIDATION_SMTP_MAX_MX_HOSTS=3

# Circuit breaker: after N consecutive total SMTP failures, skip SMTP for
# BLOCK_TTL seconds (instant `unknown` instead of timing out). Raise the
# threshold once egress is proven reliable; BLOCK_TTL=0 disables it.
VALIDATION_SMTP_FAILURE_THRESHOLD=5
VALIDATION_SMTP_BLOCK_TTL=600

# ── IP-reputation protection (per-provider rate limiting) ────────────────────
# Conservative on purpose — hammering Gmail/Outlook from one IP gets you
# greylisted, then blocklisted. Loosen with data, never the reverse.
VALIDATION_SMTP_RATE_LIMIT_ENABLED=True
VALIDATION_SMTP_MAX_CONCURRENT_PER_PROVIDER=2
VALIDATION_SMTP_MAX_PROBES_PER_MINUTE_PER_PROVIDER=10
VALIDATION_SMTP_MAX_PROBES_PER_MINUTE_GLOBAL=20
VALIDATION_SMTP_PROVIDER_COOLDOWN=900
VALIDATION_SMTP_SOFT_FAIL_THRESHOLD=3

# Greylisting (SMTP 450): re-probe after a delay instead of finalizing unknown.
VALIDATION_GREYLIST_RETRY_DELAY=600
VALIDATION_GREYLIST_MAX_RETRIES=2

# Catch-all is cached per domain, so we probe a garbage address at most once
# per domain per TTL rather than once per address.
VALIDATION_CATCHALL_TTL=86400

# ── Verify the box before trusting it ────────────────────────────────────────
#   docker compose -f docker-compose.smtp-egress.yml run --rm \
#     smtp-egress-worker python manage.py check_smtp_egress
# Checks port-25 egress, the A record, PTR/FCrDNS, SPF, and a live RCPT probe.
